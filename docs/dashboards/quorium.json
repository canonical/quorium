{
  "title": "Quorium",
  "uid": "quorium-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Leaders per node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (instance) (quorium_shard_leader)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Raft term by shard",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "max by (shard) (quorium_shard_term)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Election churn (term increase / 5m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(quorium_shard_term[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Apply lag (max - min last applied)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "max by (shard) (quorium_shard_last_applied) - min by (shard) (quorium_shard_last_applied)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Quiesced shards",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (instance) (quorium_shard_quiesced)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Append rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(quorium_appends_sent_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Ping rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(quorium_pings_received_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "WAL fsync rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(quorium_wal_fsyncs_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "WAL size",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "quorium_wal_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Writes per second by shard",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (shard) (quorium_shard_writes_per_second)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Checkpoint lag (entries since last checkpoint)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "quorium_shard_last_applied - quorium_shard_checkpoint_index",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Large entity writes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "rate(quorium_large_entity_writes_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "WAL fsync latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "quorium_wal_sync_latency_seconds",
          "refId": "A"
        }
      ]
    }
  ]
}
